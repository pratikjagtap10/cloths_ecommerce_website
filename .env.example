# Copy this file to ".env" (docker compose reads it automatically).
# These are LOCAL DEVELOPMENT values only. Never use them in production.

# ---- shared between services ----
# Django signs JWTs with this secret; FastAPI verifies them with the SAME secret
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
# Shop service -> core service internal calls (X-Internal-Key header)
INTERNAL_API_KEY=dev-internal-key-change-me
REDIS_URL=redis://redis:6379/0
EVENTS_CHANNEL=events

# ---- core service (Django) ----
DJANGO_SECRET_KEY=dev-django-secret-change-me
DJANGO_DEBUG=1
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
# 1 = load demo products/users/orders on first start
SEED_DEMO_DATA=1

# ---- databases (one per service) ----
CORE_DB_NAME=core_db
CORE_DB_USER=core
CORE_DB_PASSWORD=core
SHOP_DB_NAME=shop_db
SHOP_DB_USER=shop
SHOP_DB_PASSWORD=shop

# ---- frontend ----
# false = use the real backend through Nginx; true = JSON mock data (no backend needed)
NEXT_PUBLIC_USE_MOCK=false
