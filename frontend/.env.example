# Copy to .env.local for local (non-Docker) runs.

# true  -> UI uses JSON mock data in src/mocks (no backend needed)
# false -> UI calls the real backend through the API gateway
NEXT_PUBLIC_USE_MOCK=true

# Public URL of the API gateway (Nginx), used by the browser
NEXT_PUBLIC_API_URL=http://localhost/api

# URL used by Next.js server components inside Docker (later, with backend)
API_INTERNAL_URL=http://nginx/api
