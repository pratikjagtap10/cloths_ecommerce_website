            "pm.test('newest first', () => pm.expect(orders[0].id).to.eql(Number(pm.environment.get('order_id'))));"
          ] } }],
          "request": { "method": "GET", "header": [], "url": "{{base_url}}/api/core/orders/" }
        },
        {
          "name": "Order without token (expect 401)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{base_url}}/api/core/orders/{{order_id}}/" }
        }
      ]
    },
    {
      "name": "6. Internal APIs (service-to-service)",
      "description": "Normally only the shop service calls these. They are blocked at the gateway, so these requests go to the core service directly on port 8000.",
      "item": [
        {
          "name": "Blocked at gateway (expect 404)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('404 from Nginx', () => pm.response.to.have.status(404));"
          ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{base_url}}/internal/variants/{{variant_id}}/" }
        },
        {
          "name": "Variant without internal key (expect 403)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('403 Forbidden', () => pm.response.to.have.status(403));"
          ] } }],
          "request": { "auth": { "type": "noauth" }, "method": "GET", "header": [], "url": "{{core_url}}/internal/variants/{{variant_id}}/" }
        },
        {
          "name": "Variant with internal key",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('price and stock returned', () => pm.expect(pm.response.json()).to.include.keys('price', 'stock', 'product_name', 'is_active'));"
          ] } }],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "X-Internal-Key", "value": "{{internal_api_key}}" }],
            "url": "{{core_url}}/internal/variants/{{variant_id}}/"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "new_email", "value": "" },
    { "key": "too_many", "value": "" }
  ]
}
